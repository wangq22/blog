---
import type { UserProfile } from '../lib/api';

export interface Props {
  user: UserProfile;
}
const { user } = Astro.props;
---

<aside class="card bg-base-100 shadow w-full" aria-label="Author profile">
  <figure class="px-5 pt-5">
    <img
      src={user.avatar_url || '/favicon.svg'}
      alt={`${user.name} avatar`}
      width="400"
      height="400"
      loading="lazy"
      decoding="async"
      class="rounded-xl aspect-square object-cover w-full"
    />
  </figure>
  <div class="card-body">
    <h2 class="card-title">{user.name}</h2>
    {user.bio && <p class="text-sm opacity-80">{user.bio}</p>}
    <div class="card-actions items-center mt-2">
      {user.bilibili_url && (
        <a class="btn btn-soft btn-info btn-sm" href={user.bilibili_url} target="_blank" rel="noopener noreferrer me" aria-label="bilibili">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="m17 2-5 5-5-5"/></svg>
          Bilibili
        </a>
      )}
      {user.github_url && (
        <a class="btn btn-soft btn-sm" href={user.github_url} target="_blank" rel="noopener noreferrer me" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.35.77 1.05.77 2.12v3.15c0 .3.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          GitHub
        </a>
      )}
    </div>
  </div>
</aside>
