---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import ArchiveTimeline from '../../../components/ArchiveTimeline.astro';
import { fetchUserProfile, fetchCategories, fetchTags, fetchArchive } from '../../../lib/api';

export const prerender = true;

export async function getStaticPaths() {
  const tags = await fetchTags().catch(() => []);
  if (!tags.length) return [];
  return tags.map((t) => ({ params: { tag: t.name } }));
}

const tag = Astro.params.tag!;
const [user, categories, tags, posts] = await Promise.all([
  fetchUserProfile(),
  fetchCategories(),
  fetchTags(),
  fetchArchive({ tag }).catch(() => []),
]);
const sorted = [...posts].sort((a, b) => +new Date(b.date) - +new Date(a.date));
const canonicalPath = `/archive/tag/${encodeURIComponent(tag)}/`;
---

<BaseLayout
  title={`#${tag} archive`}
  description={`Articles tagged with "${tag}" (${sorted.length}).`}
  canonicalPath={canonicalPath}
>
  <div class="px-2 sm:px-6 md:px-12 lg:px-16 xl:px-20 py-6 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-4 gap-6">
    <Sidebar user={user} categories={categories} tags={tags} />
    <div class="lg:col-span-3 min-w-0 overflow-hidden">
      <section class="card bg-base-100 shadow" aria-label={`Articles tagged ${tag}`}>
        <div class="card-body">
          <nav class="breadcrumbs text-sm" aria-label="Breadcrumb">
            <ol class="flex gap-2">
              <li><a href="/" class="link link-hover">Home</a></li>
              <li><a href="/archive/" class="link link-hover">Archive</a></li>
              <li aria-current="page">#{tag}</li>
            </ol>
          </nav>
          <h1 class="card-title text-2xl mb-1">#{tag}'s archive</h1>
          <p class="text-sm opacity-60 mb-4">{sorted.length} articles</p>
          <ArchiveTimeline posts={sorted} />
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
