---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import PostCard from '../components/PostCard.astro';
import { fetchUserProfile, fetchCategories, fetchTags, fetchAllPosts, siteName } from '../lib/api';

export const prerender = true;

const PAGE_SIZE = 10;
const [user, categories, tags, all] = await Promise.all([
  fetchUserProfile(),
  fetchCategories(),
  fetchTags(),
  fetchAllPosts(PAGE_SIZE),
]);

// 按日期倒序(后端未保证排序时兜底)
const sorted = [...all].sort((a, b) => +new Date(b.date) - +new Date(a.date));
const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
const posts = sorted.slice(0, PAGE_SIZE);
const name = siteName();
const description = user.bio
  ? `${user.name} — ${user.bio}. Latest articles on ${categories.map((c) => c.name).slice(0, 5).join(', ') || 'programming'}.`
  : `Latest articles by ${user.name}.`;
---

<BaseLayout
  title={name}
  description={description}
  canonicalPath="/"
  extraJsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name,
    description,
  }}
>
  <div class="px-2 sm:px-6 md:px-12 lg:px-16 xl:px-20 py-6 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-4 gap-6">
    <Sidebar user={user} categories={categories} tags={tags} />
    <div class="lg:col-span-3 min-w-0 overflow-hidden">
      <section class="card bg-base-100 shadow" aria-label="Latest articles">
        <div class="card-body">
          <h1 class="card-title text-2xl mb-4">All Articles</h1>
          <div class="space-y-4">
            {posts.length === 0 ? (
              <p class="opacity-60">No articles yet.</p>
            ) : (
              posts.map((post) => <PostCard post={post} />)
            )}
          </div>
          {totalPages > 1 && (
            <nav class="join mt-6" aria-label="Pagination">
              <span class="join-item btn btn-sm btn-disabled">Page 1 of {totalPages}</span>
              <a class="join-item btn btn-sm" href="/page/2/" rel="next">Next →</a>
            </nav>
          )}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
