---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthGuard from '../../components/admin/AuthGuard';

const apiBase = import.meta.env.PUBLIC_API_BASE || 'https://blog-api.charlie-cloud.me/api';

export const prerender = true;
---

<BaseLayout title="Schedule Owner Controls" description="Private AI-assisted schedule controls." canonicalPath="/admin/schedule/" noindex={true}>
  <div class="px-4 sm:px-8 py-8 max-w-5xl mx-auto">
    <nav class="breadcrumbs text-sm mb-4" aria-label="Breadcrumb">
      <ol class="flex gap-2">
        <li><a href="/" class="link link-hover">Home</a></li>
        <li><a href="/admin/" class="link link-hover">Admin</a></li>
        <li aria-current="page">Schedule</li>
      </ol>
    </nav>
    <AuthGuard client:only="react" scheduleApiBase={apiBase}>
      <div>
        <p class="text-sm text-base-content/60">Private owner controls for the public My Schedule page.</p>
      </div>
    </AuthGuard>
  </div>
</BaseLayout>
