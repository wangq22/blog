---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthGuard from '../../components/admin/AuthGuard';

export const prerender = true;
---

<BaseLayout title="Admin" description="Blog admin dashboard." canonicalPath="/admin/" noindex={true}>
  <div class="px-4 sm:px-8 py-8 max-w-5xl mx-auto">
    <nav class="breadcrumbs text-sm mb-4" aria-label="Breadcrumb">
      <ol class="flex gap-2">
        <li><a href="/" class="link link-hover">Home</a></li>
        <li aria-current="page">Admin</li>
      </ol>
    </nav>
    <AuthGuard client:only="react">
      <div>
        <h1 class="text-2xl font-bold mb-4">Dashboard</h1>
        <div class="grid sm:grid-cols-2 gap-4">
          <a href="/admin/posts/" class="card bg-base-200 p-6 hover:shadow">
            <span class="font-semibold">Manage Posts</span>
            <span class="block text-sm opacity-60 mt-1">List / edit / delete articles</span>
          </a>
          <a href="/admin/edit/" class="card bg-base-200 p-6 hover:shadow">
            <span class="font-semibold">New Post</span>
            <span class="block text-sm opacity-60 mt-1">Write with markdown editor</span>
          </a>
        </div>
        <p class="mt-6">
          <a href="/" class="link link-hover text-sm">← Back to blog</a>
        </p>
      </div>
    </AuthGuard>
  </div>
</BaseLayout>
