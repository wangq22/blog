# 公开变量(Astro 要求 PUBLIC_ 前缀才能暴露给浏览器)
# 后端 API,结尾不带 /
PUBLIC_API_BASE=https://blog-api.charlie-cloud.me/api
# 站点 canonical 根地址,结尾不带 /
PUBLIC_SITE_URL=https://blog.charlie-cloud.me
PUBLIC_SITE_NAME=Charlie Wang's Blog
# 后台登录用 Cloudflare Access SaaS OIDC(替代已下线的 Keycloak)
# 例: PUBLIC_CF_ACCESS_TEAM_DOMAIN=https://xxx.cloudflareaccess.com (结尾不带 /)
PUBLIC_CF_ACCESS_TEAM_DOMAIN=
# Access SaaS 应用的 Client ID(即 issuer 末段)
PUBLIC_CF_ACCESS_CLIENT_ID=
